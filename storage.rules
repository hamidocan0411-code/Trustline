rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "hamidocan0411@gmail.com"
          ||
          (
            firestore.exists(
              /databases/(default)/documents/users/$(request.auth.uid)
            )
            &&
            firestore.get(
              /databases/(default)/documents/users/$(request.auth.uid)
            ).data.role == "admin"
          )
        );
    }

    function isOrderCustomer(orderId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/orders/$(orderId)
        )
        && firestore.get(
          /databases/(default)/documents/orders/$(orderId)
        ).data.customerId == request.auth.uid;
    }

    function isOrderCourier(orderId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/orders/$(orderId)
        )
        && firestore.get(
          /databases/(default)/documents/orders/$(orderId)
        ).data.courierId == request.auth.uid;
    }

    match /delivery-proofs/{orderId}/{fileName} {
      allow read: if isAdmin()
        || isOrderCustomer(orderId)
        || isOrderCourier(orderId);

      allow create, update: if isAdmin()
        || (
          isOrderCourier(orderId)
          && request.resource.size <= 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*')
        );

      allow delete: if isAdmin()
        || isOrderCourier(orderId);
    }

    match /pharmacy-prescriptions/{orderId}/{fileName} {
      allow read: if isAdmin()
        || isOrderCustomer(orderId)
        || isOrderCourier(orderId);

      allow create, update: if isOrderCustomer(orderId)
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );

      allow delete: if isAdmin()
        || isOrderCustomer(orderId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}