rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'hamidocan0411@gmail.com'
          ||
          (
            exists(
              /databases/$(database)/documents/users/$(request.auth.uid)
            )
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin'
          )
        );
    }

    function isOrderCustomer(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.customerId == request.auth.uid;
    }

    function isOrderCourier(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.courierId == request.auth.uid;
    }

    function expectedOrderPrice() {
      let pricing = get(
        /databases/$(database)/documents/pricing/default
      ).data;

      let basePrice =
        request.resource.data.distanceKm * pricing.perKmPrice < pricing.minPrice
          ? pricing.minPrice
          : request.resource.data.distanceKm * pricing.perKmPrice;

      let multiplier =
        request.resource.data.courierType == 'Acil Kurye'
          ? pricing.urgentMultiplier
          : request.resource.data.courierType == 'VIP Kurye'
            ? pricing.vipMultiplier
            : 1.0;

      let packageFee =
        request.resource.data.packageSize == 'Orta'
          ? 50
          : request.resource.data.packageSize == 'Büyük'
            ? 100
            : request.resource.data.packageSize == 'Çok Büyük'
              ? 200
              : 0;

      return basePrice * multiplier + packageFee;
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      // Public registration can only create a customer profile for the
      // currently authenticated Firebase user. Admins can create couriers.
      allow create: if (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'customer'
          && request.resource.data.email == request.auth.token.email
        )
        || (
          isAdmin()
          && request.resource.data.role in ['courier', 'corporate']
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'phone',
            'avatar',
            'vehicle',
            'plate',
            'courierStatus',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid)
        || (signedIn() && resource.data.courierId == request.auth.uid)
        || (
          signedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'corporate'
          && resource.data.customerType == 'corporate'
          && resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && (
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'corporate'
            && request.resource.data.customerType == 'corporate'
            && request.resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
            && request.resource.data.companyName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyName
          )
          ||
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
            && request.resource.data.customerType == 'individual'
          )
        )
        && request.resource.data.status == 'Kurye Bekleniyor'
        && request.resource.data.courierId == null
        && request.resource.data.orderType in ['standard', 'pharmacy']
        && request.resource.data.distanceKm is number
        && request.resource.data.distanceKm > 0
        && request.resource.data.distanceKm <= 1000
        && request.resource.data.packageCount is int
        && request.resource.data.packageCount >= 1
        && request.resource.data.packageCount <= 1000
        && request.resource.data.packageSize in ['Küçük', 'Orta', 'Büyük', 'Çok Büyük']
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price <= 1000000
        && request.resource.data.price >= expectedOrderPrice() - 0.5
        && request.resource.data.price < expectedOrderPrice() + 0.5
        && request.resource.data.customerName is string
        && request.resource.data.customerPhone is string
        && request.resource.data.pickupAddress is string
        && request.resource.data.deliveryAddress is string
        && request.resource.data.note is string;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.courierId == resource.data.courierId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.status == 'İptal Edildi'
        )
        || (
          signedIn()
          && resource.data.courierId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.courierId == resource.data.courierId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'deliveredAt',
            'courierSeenAt',
            'receiverName',
            'deliveryNote',
            'signature',
            'deliveryPhoto',
            'deliveryProof',
            'courierName',
            'courierPhone'
          ])
          && request.resource.data.status in [
            'Kurye Atandı',
            'Paket Alındı',
            'Teslimatta',
            'Teslim Edildi'
          ]
        );

      allow delete: if isAdmin();

      match /deliveryProofs/{proofId} {
        allow read: if isAdmin()
          || isOrderCustomer(orderId)
          || isOrderCourier(orderId);

        allow create: if isAdmin()
          || (
            isOrderCourier(orderId)
            && request.resource.data.courierId == request.auth.uid
          );

        allow update: if isAdmin()
          || (
            isOrderCourier(orderId)
            && resource.data.courierId == request.auth.uid
            && request.resource.data.courierId == resource.data.courierId
          );

        allow delete: if isAdmin()
          || (
            isOrderCourier(orderId)
            && resource.data.courierId == request.auth.uid
          );
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && userId == request.auth.uid);

      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      allow update: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read'
        ]);

      allow delete: if signedIn() && userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read'
          ])
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /courierLocations/{courierId} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.uid == courierId)
        || (
          signedIn()
          && resource.data.visibleToCustomerIds is list
          && request.auth.uid in resource.data.visibleToCustomerIds
        );

      allow list: if isAdmin()
        || (
          signedIn()
          && resource.data.visibleToCustomerIds is list
          && request.auth.uid in resource.data.visibleToCustomerIds
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == courierId
          && request.resource.data.courierId == request.auth.uid
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.visibleToCustomerIds is list
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == courierId
          && resource.data.courierId == request.auth.uid
          && request.resource.data.courierId == resource.data.courierId
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.visibleToCustomerIds is list
        );

      allow delete: if isAdmin()
        || (signedIn() && request.auth.uid == courierId);
    }

    match /pricing/{pricingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courierRatings/{ratingId} {
      allow read: if isAdmin()
        || isOrderCustomer(ratingId)
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.courierId == request.auth.uid
        );

      allow create: if signedIn()
        && isOrderCustomer(ratingId)
        && request.resource.data.orderId == ratingId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.courierId ==
          get(/databases/$(database)/documents/orders/$(ratingId)).data.courierId
        && get(/databases/$(database)/documents/orders/$(ratingId)).data.status == 'Teslim Edildi'
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;

      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'bekliyor'
        && request.resource.data.customerEmail == request.auth.token.email;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastMessage',
            'lastMessageAt',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.customerId == request.auth.uid
          );

        allow create: if isAdmin()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.customerId == request.auth.uid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'customer'
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
          )
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.assignedAdminId == request.auth.uid
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.senderRole == 'admin'
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 2000
          );

        allow update: if isAdmin();

        allow delete: if isAdmin()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.customerId == request.auth.uid
          );
      }
    }
  }
}