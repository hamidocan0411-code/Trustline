rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == 'hamidocan0411@gmail.com'
          ||
          (
            exists(
              /databases/$(database)/documents/users/$(request.auth.uid)
            )
            &&
            get(
              /databases/$(database)/documents/users/$(request.auth.uid)
            ).data.role == 'admin'
          )
        );
    }

    function isOrderCustomer(orderId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.customerId == request.auth.uid;
    }

    function isOrderCourier(orderId) {
      return signedIn()
        && get(
          /databases/$(database)/documents/orders/$(orderId)
        ).data.courierId == request.auth.uid;
    }

    match /users/{userId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
        );

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'email',
            'phone',
            'avatar',
            'vehicle',
            'plate',
            'courierStatus',
            'updatedAt'
          ])
        );

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {

      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.courierId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Kurye Bekleniyor'
        && request.resource.data.courierId == null;

      allow update: if isAdmin()

        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.courierId == resource.data.courierId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && request.resource.data.status == 'İptal Edildi'
        )

        || (
          signedIn()
          && resource.data.courierId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.courierId == resource.data.courierId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'deliveredAt',
            'courierSeenAt',
            'receiverName',
            'deliveryNote',
            'signature',
            'deliveryPhoto',
            'deliveryProof',
            'courierName',
            'courierPhone'
          ])
        );

      allow delete: if isAdmin();

      match /deliveryProofs/{proofId} {

        allow read: if isAdmin()
          || isOrderCustomer(orderId)
          || isOrderCourier(orderId);

        allow create: if isAdmin()
          || (
            isOrderCourier(orderId)
            && request.resource.data.courierId == request.auth.uid
          );

        allow update: if isAdmin()
          || (
            isOrderCourier(orderId)
            && resource.data.courierId == request.auth.uid
          );

        allow delete: if isAdmin()
          || (
            isOrderCourier(orderId)
            && resource.data.courierId == request.auth.uid
          );
      }
    }

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if signedIn()
        && userId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isAdmin()
        || (
          signedIn()
          && request.resource.data.userId == request.auth.uid
        );

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        );
    }

    match /courierLocations/{courierId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == courierId;

      allow update: if signedIn()
        && request.auth.uid == courierId;

      allow delete: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == courierId
        );
    }

    match /pricing/{pricingId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courierRatings/{ratingId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.courierId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow update, delete: if isAdmin();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (
            signedIn()
            && get(
              /databases/$(database)/documents/supportTickets/$(ticketId)
            ).data.customerId == request.auth.uid
          );

        allow create: if isAdmin()
          || (
            signedIn()
            && request.resource.data.senderId == request.auth.uid
          );

        allow update, delete: if isAdmin();
      }
    }
  }
}