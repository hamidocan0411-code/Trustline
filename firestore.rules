rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && (
          request.auth.token.email == "hamidocan0411@gmail.com"
          || exists(
            /databases/$(database)/documents/admins/$(request.auth.uid)
          )
        );
    }

    function isCourier() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "courier";
    }

    function isOrderCustomer() {
      return signedIn()
        && resource.data.customerId == request.auth.uid;
    }

    function isOrderCourier() {
      return signedIn()
        && resource.data.courierId == request.auth.uid;
    }


    // =========================
    // USERS
    // =========================

    match /users/{userId} {

      allow create:
        if signedIn()
        && request.auth.uid == userId;

      allow read:
        if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || isCourier()
        );

      allow update:
        if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete:
        if isAdmin();
    }


    // =========================
    // ADMINS
    // =========================

    match /admins/{adminId} {

      allow read:
        if isAdmin();

      allow write:
        if isAdmin();
    }


    // =========================
    // PRICING
    // =========================

    match /pricing/{pricingId} {

      allow read:
        if true;

      allow write:
        if isAdmin();
    }


    // =========================
    // ORDERS
    // =========================

    match /orders/{orderId} {

      allow create:
        if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow read:
        if signedIn()
        && (
          resource.data.customerId == request.auth.uid
          || resource.data.courierId == request.auth.uid
          || isAdmin()
        );

      allow update:
        if signedIn()
        && (
          isAdmin()

          ||

          (
            resource.data.customerId == request.auth.uid
            && request.resource.data.customerId == request.auth.uid
            && request.resource.data.status == "İptal Edildi"
          )

          ||

          (
            resource.data.courierId == request.auth.uid
            && request.resource.data.courierId == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "updatedAt",
                "note",
                "deliveredAt",
                "receiverName",
                "deliveryNote",
                "deliveryPhoto",
                "signature",
                "deliveryProof"
              ])
          )
        );

      allow delete:
        if isAdmin();
    }


    // =========================
    // COURIER LOCATIONS
    // =========================

    match /courierLocations/{courierId} {

      allow read:
        if signedIn()
        && (
          request.auth.uid == courierId
          || isAdmin()
          || resource.data.isSharing == true
        );

      allow create:
        if signedIn()
        && (
          request.auth.uid == courierId
          || isAdmin()
        );

      allow update:
        if signedIn()
        && (
          request.auth.uid == courierId
          || isAdmin()
        );

      allow delete:
        if signedIn()
        && (
          request.auth.uid == courierId
          || isAdmin()
        );
    }


    // =========================
    // NOTIFICATIONS
    // =========================

    match /notifications/{notificationId} {

      allow read:
        if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      allow create:
        if signedIn();

      allow update:
        if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "read"
          ]);

      allow delete:
        if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );
    }


    // =========================
    // DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}